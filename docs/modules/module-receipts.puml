    Component(LedgerlyApplication.LedgerlyApplication.Shared, "Shared", $techn="Module", $descr="", $tags="", $link="")
    Component(LedgerlyApplication.LedgerlyApplication.Expenses, "Expenses", $techn="Module", $descr="", $tags="", $link="")
    Component(LedgerlyApplication.LedgerlyApplication.Receipts, "Receipts", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(LedgerlyApplication.LedgerlyApplication.Expenses, LedgerlyApplication.LedgerlyApplication.Shared, "uses", $techn="", $tags="", $link="")
