    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("LedgerlyApplication_boundary", "LedgerlyApplication", $tags="") {
